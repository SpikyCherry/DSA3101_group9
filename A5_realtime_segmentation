    {
      "cell_type": "code",
      "source": [
        "# We will use 5 clusters as suggested by the Dendrogram\n",
        "hc = AgglomerativeClustering(n_clusters=5, metric='euclidean', linkage='ward')\n",
        "hc_clustered = hc.fit_predict(df_scaled)"
